---
import Items from "#/src/components/Item";
import Viewer from "#/src/components/Viewer";
import Layout from "#/src/layouts/Layout.astro";
---

<script>
  import { getEmails, arrEmails, mobileView } from "src/store/current-email";

  const form = document.querySelector("#email-form") as HTMLFormElement;
  const input = document.querySelector("#email-input") as HTMLInputElement;
  const clearBtn = document.querySelector("#clear-input") as HTMLButtonElement;

  function updateClearButton() {
    clearBtn.hidden = !input.value;
  }

  input.addEventListener("input", () => {
    updateClearButton();
  });

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const email = input.value.trim();
    getEmails(email);
    input.blur();
  });

  clearBtn.addEventListener("click", () => {
    input.value = "";
    updateClearButton();
    getEmails("");
    input.focus();
  });

  window.addEventListener("recent-email-selected", ((e: CustomEvent) => {
    const email = e.detail;
    input.value = email;
    updateClearButton();
    getEmails(email);
  }) as EventListener);

  const datalist = document.querySelector("datalist")!;

  arrEmails.subscribe((emails) => {
    datalist.innerHTML = emails
      .toSorted((a, b) => (b.lastUsed || 0) - (a.lastUsed || 0))
      .map((email) => `<option value="${email.email}">${email.email}@restmail.net</option>`)
      .join("");
  });

  // Mobile view toggling
  const listPanel = document.querySelector('[data-mobile-panel="list"]') as HTMLElement;
  const viewerPanel = document.querySelector('[data-mobile-panel="viewer"]') as HTMLElement;

  function applyMobileView(view: string) {
    const isMobile = window.matchMedia('(max-width: 767px)').matches;
    if (isMobile) {
      listPanel.style.display = view === 'list' ? 'flex' : 'none';
      viewerPanel.style.display = view === 'viewer' ? 'flex' : 'none';
    } else {
      listPanel.style.display = 'flex';
      viewerPanel.style.display = 'flex';
    }
  }

  mobileView.subscribe(applyMobileView);
  window.matchMedia('(max-width: 767px)').addEventListener('change', () => {
    applyMobileView(mobileView.get());
  });
</script>

<Layout title="Restmail UI">
  <main class="flex flex-col md:flex-row w-full h-dvh bg-[#0f172a] text-gray-100">
    <!-- Sidebar -->
    <section data-mobile-panel="list" class="flex flex-col w-full md:w-80 md:min-w-[320px] bg-[#1e293b] h-full border-r border-[#334155]">
      <!-- Header -->
      <div class="px-4 py-5 border-b border-[#334155]">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-9 h-9 rounded-lg bg-indigo-500/20 flex items-center justify-center">
            <svg class="w-5 h-5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <h1 class="text-base font-semibold text-white">Restmail</h1>
            <p class="text-xs text-slate-400">Temporary email viewer</p>
          </div>
        </div>

        <!-- Search input -->
        <form id="email-form" class="relative" autocomplete="off">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            id="email-input"
            class="w-full rounded-lg py-2.5 pl-10 pr-36 bg-[#0f172a] text-sm text-slate-200 placeholder-slate-500 border border-[#334155] transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500/50"
            placeholder="Enter username..."
            type="text"
            list="emails"
            autocomplete="off"
            autocapitalize="off"
          />
          <div class="absolute inset-y-0 right-0 pr-3 flex items-center gap-1">
            <button
              id="clear-input"
              hidden
              class="p-0.5 rounded text-slate-400 hover:text-white hover:bg-slate-600/50 transition-colors"
              type="button"
              title="Limpiar"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
            <span class="text-xs text-slate-500 font-mono pointer-events-none">@restmail.net</span>
          </div>
          <datalist id="emails"> </datalist>
        </form>
      </div>

      <!-- Email list -->
      <div class="flex-1 overflow-y-auto overflow-x-hidden">
        <Items client:only="preact" />
      </div>
    </section>

    <!-- Viewer -->
    <div data-mobile-panel="viewer" class="w-full md:flex-1 flex h-full">
      <Viewer client:visible />
    </div>
  </main>
</Layout>
